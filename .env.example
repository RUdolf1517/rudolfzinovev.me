# Copy to .env and edit. Never commit .env.
RZ_BIND=127.0.0.1:8080      # behind Caddy/nginx; use 0.0.0.0:8080 in Docker
RZ_DATA=/srv/rudolfzinovev/data
RZ_OWNER=owner              # cabinet login name
RZ_PASSWORD=                 # leave empty to generate one on first boot (printed once in logs)
RZ_WORKERS=2                # one worker per vCPU is plenty
RZ_GZIP=1
RZ_SEED=1                   # seed 4 bilingual article pairs on an empty database
