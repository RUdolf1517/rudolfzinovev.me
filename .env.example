# Copy to .env and edit. Never commit .env.
# One KEY=VALUE per line — systemd's EnvironmentFile and Docker both treat
# anything after the value as part of the value, so comments go on their own line.

# Interface to bind. Behind Caddy/nginx use 127.0.0.1:8080; in Docker use 0.0.0.0:8080.
RZ_BIND=127.0.0.1:8080

# Directory holding site.sqlite (created automatically).
RZ_DATA=/srv/rudolfzinovev/data

# Cabinet login name.
RZ_OWNER=owner

# Leave empty on first boot to have a password generated and printed once in the log.
RZ_PASSWORD=

# Request worker threads — one per vCPU is plenty.
RZ_WORKERS=2

# gzip responses on the fly (1/0).
RZ_GZIP=1

# Seed four bilingual article pairs into an empty database (1/0).
RZ_SEED=1
