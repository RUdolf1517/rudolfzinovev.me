# Build outputs
/target/

# Cargo.lock is generated by cargo and lists the resolved dependency tree.
# Committing a stale or hand-written one is worse than not having it: the file
# changes on every `cargo build` after a dependency bump, which makes the work
# tree "dirty" and silently blocks `git pull` in deploy/pull-and-run.fish.
Cargo.lock

# Local SQLite database & WAL files
/data/
*.db
*.db-shm
*.db-wal

# Local secrets & environment files
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
